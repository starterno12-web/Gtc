name: Prepare and build Android APK (manual only)

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  unpack-and-build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          persist-credentials: true

      - name: Require successfully persisted model weights
        shell: bash
        run: |
          set -euo pipefail
          for f in nlm2.bin nlm2.npz weights/nlm2.npz android/app/src/main/assets/nlm2.bin; do
            test -s "$f" || { echo "::error::Required persisted model file is missing: $f"; exit 1; }
          done
          cmp -s nlm2.bin android/app/src/main/assets/nlm2.bin || { echo "::error::Android model asset is not identical to root nlm2.bin"; exit 1; }
          cmp -s nlm2.npz weights/nlm2.npz || { echo "::error::Root NPZ differs from weights/nlm2.npz"; exit 1; }
          echo "Persisted model files verified. APK build is permitted only after this gate."

      - name: Unpack ZIP, compare, and merge into repository root
        shell: bash
        run: |
          set -euo pipefail
          ZIP_FILE="نواة_الحزمة_الكاملة.zip"
          test -f "$ZIP_FILE" || { echo "::error::ZIP file not found: $ZIP_FILE"; exit 1; }
          rm -rf /tmp/package-unpacked
          mkdir -p /tmp/package-unpacked
          unzip -q "$ZIP_FILE" -d /tmp/package-unpacked
          SRC="/tmp/package-unpacked"
          shopt -s dotglob nullglob
          entries=("$SRC"/*)
          if [ "${#entries[@]}" -eq 1 ] && [ -d "${entries[0]}" ]; then SRC="${entries[0]}"; fi
          while IFS= read -r -d '' file; do
            rel="${file#"$SRC"/}"
            case "$rel" in ../*|*/../*|*/..|/*) echo "::error::Unsafe path in archive: $rel"; exit 1;; esac
            dest="$GITHUB_WORKSPACE/$rel"
            mkdir -p "$(dirname "$dest")"
            if [ -e "$dest" ]; then
              if cmp -s "$file" "$dest"; then echo "IDENTICAL: $rel"; else echo "CONFLICT (kept existing): $rel"; fi
            else
              cp -p "$file" "$dest"
              echo "ADDED: $rel"
            fi
          done < <(find "$SRC" -type f -print0)
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          if ! git diff --cached --quiet; then
            git commit -m "Extract package archive into repository"
            git push
          fi

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - name: Set up Gradle 8.2.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.2.1"
      - name: Build Android application
        shell: bash
        run: |
          set -euo pipefail
          test -f android/settings.gradle.kts
          test -f android/build.gradle.kts
          test -f android/app/build.gradle.kts
          gradle --no-daemon -p android :app:assembleDebug

      - name: Publish debug APK
        uses: actions/upload-artifact@v4
        with:
          name: gtc-android-debug-apk
          path: android/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 90
