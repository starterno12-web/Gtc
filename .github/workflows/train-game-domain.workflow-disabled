name: Cumulative game-development AI training
on:
  workflow_dispatch:
    inputs:
      epochs:
        description: Training epochs per run
        default: "40"
        type: string
permissions:
  contents: write
concurrency:
  group: cumulative-game-ai-training
  cancel-in-progress: false
jobs:
  train:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: true
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install CPU-only PyTorch and NumPy
        run: pip install numpy torch --index-url https://download.pytorch.org/whl/cpu
      - name: Bootstrap from first training checkpoint (if master checkpoint is absent)
        continue-on-error: true
        uses: actions/download-artifact@v4
        with:
          name: game-domain-gru-checkpoint
          run-id: 44493771599
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: training/checkpoints/
      - name: Train cumulatively using all curriculum files
        run: python training/train_domain_gru.py --epochs "${{ github.event.inputs.epochs || '40' }}"
      - name: Upload master checkpoint artifact
        uses: actions/upload-artifact@v4
        with:
          name: game-domain-master-checkpoint
          path: training/checkpoints/game_domain_master.pt
          retention-days: 90
      - name: Commit master checkpoint to repository for next round
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add training/checkpoints/game_domain_master.pt
          git commit -m "[domain-train] update cumulative game AI checkpoint" || echo "No checkpoint changes to commit"
          git push
