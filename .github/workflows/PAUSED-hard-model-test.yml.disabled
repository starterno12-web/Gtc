name: PAUSED -  Final browser interface challenge and validation
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  hard-test:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: true
      - name: Install dependencies
        run: python -m pip install --no-cache-dir numpy torch
      - name: Verify trained checkpoint
        run: test -s weights/nlm2_article_curriculum.bin
      - name: Ask the final, hardest browser coding question
        run: python scripts/run_hard_model_test.py --weights weights/nlm2_article_curriculum.bin --prompt tests/hard_coding_prompt.txt --out hard_test_answer.txt --tokens 1800 --temperature 0.85 --top-k 12
      - name: Detect whether the answer is a real browser interface
        run: python scripts/validate_browser_interface.py
      - name: Verify outputs and preserve trained weights
        run: |
          test -s hard_test_answer.txt
          test -s hard_test_validation.txt
          git diff --exit-code HEAD -- weights/nlm2_article_curriculum.bin nlm2.bin weights/nlm2.npz
      - name: Commit raw answer and validation report
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add hard_test_answer.txt hard_test_validation.txt
          git commit -m "Save final browser interface test and validation"
          git push
